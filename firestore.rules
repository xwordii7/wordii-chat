rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null &&
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false) != true);
    }
    // level must match points: level = 1 + floor(points / 10)
    function lvlOk(d) {
      return d.level is int && d.points is int && d.level >= 1
        && (d.level - 1) * 10 <= d.points && d.points < d.level * 10;
    }
    function okStatus(d) {
      return d.keys().hasOnly(['ownerUid', 'viewers', 'text', 'bg', 'img', 'close', 'mentions', 'via', 'createdAt', 'musicId', 'audioPath', 'musicStart', 'musicDuration', 'videoPath'])
        && (!('musicId' in d) || (d.musicId is string && d.musicId.matches('^am_[A-Za-z0-9]{1,100}$')))
        && (!('audioPath' in d) || (d.audioPath is string && d.audioPath.matches('^status-audio/[A-Za-z0-9_-]+/[A-Za-z0-9]+/track[.](mp3|m4a|aac|wav)$') && d.audioPath.size() <= 180))
        && (!('musicStart' in d) || (d.musicStart is number && d.musicStart >= 0 && d.musicStart <= 7200))
        && (!('musicDuration' in d) || (d.musicDuration is number && d.musicDuration >= 1 && d.musicDuration <= 30))
        && (!('videoPath' in d) || (d.videoPath is string && d.videoPath.matches('^status-video/[A-Za-z0-9_-]+/[A-Za-z0-9]+/clip[.](mp4|webm)$')))
        && !('musicId' in d && 'audioPath' in d)
        && (!('close' in d) || d.close is bool)
        && (!('mentions' in d) || (d.mentions is list && d.mentions.size() <= 10))
        && (!('via' in d) || (d.via is string && d.via.size() <= 60))
        && d.ownerUid is string && d.viewers is list && d.viewers.size() <= 100
        && (
          ('text' in d && !('img' in d) && d.text is string && d.text.size() > 0 && d.text.size() <= 300
            && d.bg is int && d.bg >= 0 && d.bg < 8)
          ||
          ('img' in d && !('text' in d) && !('bg' in d) && !('videoPath' in d) && d.img is string && d.img.size() > 100 && d.img.size() <= 400000)
          ||
          ('videoPath' in d && !('img' in d) && !('text' in d) && !('bg' in d) && !('audioPath' in d) && !('musicId' in d))
        );
    }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('admin', false) == true;
    }
    function isBTP() {
      return signedIn() && (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('preAdmin', false) == true);
    }
    function chatMembers(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }
    function chatNotBlocked(chatId) {
      let members = chatMembers(chatId);
      return members.size() != 2 || (
        !(members[0] in get(/databases/$(database)/documents/users/$(members[1])).data.get('blockedUsers', []))
        && !(members[1] in get(/databases/$(database)/documents/users/$(members[0])).data.get('blockedUsers', []))
      );
    }

    // Public plan settings, but only an existing admin can change the price or availability.
    match /wordiiConfig/{configId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && configId == 'botWelcome'
        && request.resource.data.keys().hasOnly(['text','updatedAt','updatedBy'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow create, update: if isAdmin() && configId == 'botAnnouncement'
        && request.resource.data.keys().hasOnly(['text','updatedAt','updatedBy'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow create, update: if isAdmin() && configId == 'appBranding'
        && request.resource.data.keys().hasOnly(['logo','updatedAt','updatedBy'])
        && request.resource.data.logo is string
        && (request.resource.data.logo == '' || (request.resource.data.logo.matches('^data:image/jpeg;base64,.*') && request.resource.data.logo.size() <= 85000))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow create, update: if isAdmin() && configId in ['verifiedPlan','premiumPlan']
        && request.resource.data.keys().hasOnly(['price','enabled','updatedAt','updatedBy'])
        && request.resource.data.price is int && request.resource.data.price >= 1 && request.resource.data.price <= 10000
        && request.resource.data.enabled is bool && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /verifiedRequests/{requestId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','username','utr','proof','price','status','createdAt','plan'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'premium')
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
        && request.resource.data.utr is string && request.resource.data.utr.matches('^[A-Za-z0-9-]{8,45}$')
        && request.resource.data.proof is string && request.resource.data.proof.matches('^data:image/jpeg;base64,.*')
        && request.resource.data.proof.size() <= 180000
        && (
          (!('plan' in request.resource.data)
            && get(/databases/$(database)/documents/wordiiConfig/verifiedPlan).data.enabled == true
            && request.resource.data.price == get(/databases/$(database)/documents/wordiiConfig/verifiedPlan).data.price)
          ||
          (request.resource.data.get('plan', '') == 'premium'
            && get(/databases/$(database)/documents/wordiiConfig/premiumPlan).data.enabled == true
            && request.resource.data.price == get(/databases/$(database)/documents/wordiiConfig/premiumPlan).data.price)
        );
      allow update: if isAdmin() && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    // A suspended user can only submit a limited appeal; they cannot chat.
    match /suspensionAppeals/{appealId} {
      allow get, list: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && appealId == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false) == true
        && request.resource.data.keys().hasOnly(['uid', 'message', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['reviewed', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    // Admin-created deletion requests. A trusted Admin SDK script must execute them.
    match /accountDeletionRequests/{targetUid} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.auth.uid != targetUid
        && exists(/databases/$(database)/documents/users/$(targetUid))
        && get(/databases/$(database)/documents/users/$(targetUid)).data.get('admin', false) != true
        && request.resource.data.keys().hasOnly(['targetUid', 'targetUsername', 'requestedBy', 'requestedAt', 'status'])
        && request.resource.data.targetUid == targetUid
        && request.resource.data.targetUsername is string
        && request.resource.data.targetUsername.size() <= 120
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.requestedAt == request.time
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // One profile per account, created once, never edited.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'usernameKey', 'verified', 'admin', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameKey)).data.uid == uid
        && (
          // Normal users: new usernames or legacy tagged usernames.
          (!('verified' in request.resource.data)
            && !('admin' in request.resource.data)
            && (
              (request.resource.data.usernameKey.matches('^[a-z0-9_]{3,15}$')
                && request.resource.data.username == '@' + request.resource.data.usernameKey)
              ||
              (request.resource.data.usernameKey.matches('^[a-z0-9_]{3,15}-[0-9]{3}$')
                && request.resource.data.username ==
                   '@' + request.resource.data.usernameKey.split('-')[0] + '#' + request.resource.data.usernameKey.split('-')[1])
            ))

        );
      // Owner may change only displayName and avatar (small JPEG as text).
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatar', 'banner', 'bio', 'isPublic', 'showOnline', 'blockedUsers'])
        && (!('displayName' in request.resource.data)
            || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 30))
        && (!('avatar' in request.resource.data)
            || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 40000))
        && (!('banner' in request.resource.data)
            || (request.resource.data.banner is string && request.resource.data.banner.size() <= 90000))
        && (!('bio' in request.resource.data)
            || (request.resource.data.bio is string && request.resource.data.bio.size() <= 150))
        && (!('isPublic' in request.resource.data) || request.resource.data.isPublic is bool)
        && (!('showOnline' in request.resource.data) || request.resource.data.showOnline is bool)
        && (!('blockedUsers' in request.resource.data) || (request.resource.data.blockedUsers is list && request.resource.data.blockedUsers.size() <= 300));
      // Username changes must be atomic with a new reserved username.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username','usernameKey'])
        && request.resource.data.usernameKey.matches('^[a-z0-9_]{3,15}$')
        && request.resource.data.username == '@' + request.resource.data.usernameKey
        && request.resource.data.usernameKey != resource.data.usernameKey
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameKey)).data.uid == uid;
      // +1 point per active minute. Pace is checked against the SERVER clock.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'level', 'lastMinuteAt'])
        && request.resource.data.lastMinuteAt == request.time
        && request.time > resource.data.get('lastMinuteAt', request.time - duration.value(1, 'd')) + duration.value(55, 's')
        && request.resource.data.points == resource.data.get('points', 0) + 1
        && lvlOk(request.resource.data);
      // +4 points once per day; streak grows only if you also claimed yesterday.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'level', 'streak', 'lastDay'])
        && request.resource.data.lastDay is int
        && request.resource.data.lastDay * 86400000 <= request.time.toMillis()
        && request.time.toMillis() < (request.resource.data.lastDay + 1) * 86400000
        && request.resource.data.lastDay > resource.data.get('lastDay', -1)
        && request.resource.data.points == resource.data.get('points', 0) + 4
        && request.resource.data.streak == (resource.data.get('lastDay', -5) == request.resource.data.lastDay - 1
             ? resource.data.get('streak', 0) + 1 : 1)
        && lvlOk(request.resource.data);
      // Online presence: the app stamps lastSeen (server time) about once a minute while it is open.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
        && request.resource.data.lastSeen == request.time;
      // Admin can give or remove the blue verified badge of any user.
      allow update: if isAdmin() && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified','premium','preAdmin'])
        && (!('verified' in request.resource.data) || request.resource.data.verified is bool)
        && (!('premium' in request.resource.data) || request.resource.data.premium is bool)
        && (!('preAdmin' in request.resource.data) || request.resource.data.preAdmin is bool)
        && resource.data.get('admin', false) != true;
      // Only full Admin can suspend or restore a non-admin account.
      allow update: if isAdmin() && request.auth.uid != uid
        && resource.data.get('admin', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspended', 'suspendedAt', 'suspendedBy'])
        && request.resource.data.suspended is bool
        && request.resource.data.suspendedBy == request.auth.uid
        && request.resource.data.suspendedAt == request.time;
      // Pre-Admins can manage user Verified/Premium badges, never Admin/Pre-Admin roles.
      allow update: if isBTP() && !isAdmin() && request.auth.uid != uid
        && resource.data.get('admin', false) != true
        && resource.data.get('preAdmin', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified','premium'])
        && (!('verified' in request.resource.data) || request.resource.data.verified is bool)
        && (!('premium' in request.resource.data) || request.resource.data.premium is bool);
      // Follower counter: +1 / -1 only together with creating / deleting the follow record.
      allow update: if signedIn() && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount'])
        && (
          (request.resource.data.followersCount == resource.data.get('followersCount', 0) + 1
            && !exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid))
            && existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid)))
          ||
          (request.resource.data.followersCount == resource.data.get('followersCount', 0) - 1
            && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid))
            && !existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid)))
        );
      allow delete: if false;

      // Private: your phone's push subscriptions (only you can read/write; the Render server reads them with admin rights).
      match /private/{doc} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid && doc == 'push'
          && request.resource.data.keys().hasOnly(['subs', 'fcmTokens'])
          && (!('subs' in request.resource.data) ||
              (request.resource.data.subs is list && request.resource.data.subs.size() <= 5))
          && (!('fcmTokens' in request.resource.data) ||
              (request.resource.data.fcmTokens is list &&
               request.resource.data.fcmTokens.size() <= 5));
        allow delete: if false;
      }
    }

    // Reserves a username. A second create on the same name fails, so no duplicates.
    // Atomic username rename: reserve the new key, update own profile, remove old key.
    // getAfter makes this impossible without the matching user record change.
    match /usernames/{key} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameKey == key
        && (
          key.matches('^[a-z0-9_]{3,15}$')
          || key.matches('^[a-z0-9_]{3,15}-[0-9]{3}$')
        );
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameKey != key;
      allow update: if false;
    }

        // Level Gifts: everyone signed in can view; only Admin can manage.
    match /levelRewards/{giftId} {
      allow read: if signedIn();
      allow create, update: if isBTP()
        && request.resource.data.keys().hasOnly(['level', 'gift', 'exp', 'photo', 'updatedAt', 'updatedBy'])
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 10000
        && giftId == string(request.resource.data.level)
        && request.resource.data.gift is string
        && request.resource.data.gift.size() > 0
        && request.resource.data.gift.size() <= 120
        && request.resource.data.exp is int && request.resource.data.exp >= 0 && request.resource.data.exp <= 100000
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 70000
        && (request.resource.data.photo == '' || request.resource.data.photo.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isBTP();
    }

    // One active partner per account. Lock writes must be atomic with the invite status.
    match /couplePartnerLocks/{personId} {
      allow get: if signedIn() && (request.auth.uid == personId || request.auth.uid == resource.data.partnerUid);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['pairId','partnerUid'])
        && request.resource.data.partnerUid is string
        && request.resource.data.partnerUid != personId
        && request.auth.uid in [personId, request.resource.data.partnerUid]
        && request.resource.data.pairId == (personId < request.resource.data.partnerUid
            ? personId + '_' + request.resource.data.partnerUid
            : request.resource.data.partnerUid + '_' + personId)
        && getAfter(/databases/$(database)/documents/coupleInvites/$(request.resource.data.pairId)).data.status == 'accepted'
        && !exists(/databases/$(database)/documents/couplePartnerLocks/$(personId));
      allow delete: if signedIn()
        && request.auth.uid in [personId, resource.data.partnerUid]
        && getAfter(/databases/$(database)/documents/coupleInvites/$(resource.data.pairId)).data.status == 'disconnected';
      allow update: if false;
    }

    // Couple invitations: consent only; no client can grant a paid badge.
    match /coupleInvites/{pairId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members','from','to','fromName','toName','status','createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && request.resource.data.members[0] in [request.auth.uid, request.resource.data.to]
        && request.resource.data.members[1] in [request.auth.uid, request.resource.data.to]
        && pairId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && exists(/databases/$(database)/documents/users/$(request.resource.data.to))
        && request.resource.data.fromName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
        && request.resource.data.toName == get(/databases/$(database)/documents/users/$(request.resource.data.to)).data.username
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','updatedBy'])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (
          (resource.data.status == 'pending' && request.auth.uid == resource.data.to
            && request.resource.data.status == 'rejected')
          || (resource.data.status == 'pending' && request.auth.uid == resource.data.to
            && request.resource.data.status == 'accepted'
            && getAfter(/databases/$(database)/documents/couplePartnerLocks/$(resource.data.from)).data.pairId == pairId
            && getAfter(/databases/$(database)/documents/couplePartnerLocks/$(resource.data.to)).data.pairId == pairId)
          || (resource.data.status in ['pending','accepted']
            && request.resource.data.status == 'disconnected'
            && (resource.data.status != 'accepted'
              || (!existsAfter(/databases/$(database)/documents/couplePartnerLocks/$(resource.data.from))
                && !existsAfter(/databases/$(database)/documents/couplePartnerLocks/$(resource.data.to)))))
        );
      allow delete: if false;
    }

    // Temporary 6-digit friend codes. Can be fetched by exact code only (no listing).
    match /connectCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && code.matches('^[0-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid', 'expiresAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(12, 'm')
        && (resource == null || resource.data.uid == request.auth.uid || resource.data.expiresAt < request.time);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Status: visible to the owner and to the friends listed in `viewers` (24 h is enforced by the app).
    
    // Admin-managed music catalog
    match /wordiiAdminMusic/{trackId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin()
        && trackId.matches('^am_[A-Za-z0-9]{1,100}$');
    }

    match /wordiiAdminMusicAudio/{trackId} {
      allow read: if signedIn()
        && exists(/databases/$(database)/documents/wordiiAdminMusic/$(trackId))
        && get(/databases/$(database)/documents/wordiiAdminMusic/$(trackId)).data.enabled == true;
      allow create, update, delete: if isAdmin()
        && trackId.matches('^am_[A-Za-z0-9]{1,100}$');
    }

    match /statuses/{id} {
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || request.auth.uid in resource.data.viewers);
      allow create: if signedIn() && okStatus(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Who saw / liked a status. The viewer writes their own record; the owner reads them all.
      match /views/{viewerId} {
        allow read: if signedIn() && (viewerId == request.auth.uid
          || get(/databases/$(database)/documents/statuses/$(id)).data.ownerUid == request.auth.uid);
        allow create: if signedIn() && viewerId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/statuses/$(id)).data.viewers
          && request.resource.data.keys().hasOnly(['liked', 'at'])
          && request.resource.data.liked is bool
          && request.resource.data.at == request.time;
        allow update: if signedIn() && viewerId == request.auth.uid
          && request.resource.data.keys().hasOnly(['liked', 'at'])
          && request.resource.data.liked is bool
          && request.resource.data.at == resource.data.at;
        allow delete: if false;
      }
    }

    // Chat requests (found by username search). Pair id = both uids sorted, same as the chat id.
    match /requests/{pairId} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'note', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && pairId == (request.auth.uid < request.resource.data.to
             ? request.auth.uid + '_' + request.resource.data.to
             : request.resource.data.to + '_' + request.auth.uid)
        && request.resource.data.note is string && request.resource.data.note.size() <= 100
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.to))
        && !exists(/databases/$(database)/documents/chats/$(pairId));
      allow update: if false;
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Voice / video calls: WebRTC signalling only (the call itself goes phone to phone).
    match /calls/{callId} {
      allow read: if signedIn() && (resource.data.caller == request.auth.uid || resource.data.callee == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['caller', 'callee', 'type', 'status', 'offer', 'createdAt'])
        && request.resource.data.caller == request.auth.uid
        && request.resource.data.callee is string && request.resource.data.callee != request.auth.uid
        && request.resource.data.type in ['audio', 'video']
        && request.resource.data.status == 'ringing'
        && request.resource.data.offer.sdp.size() < 30000
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/chats/$(request.auth.uid < request.resource.data.callee
             ? request.auth.uid + '_' + request.resource.data.callee
             : request.resource.data.callee + '_' + request.auth.uid));
      allow update: if signedIn() && (
          (resource.data.callee == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answer'])
            && request.resource.data.status in ['accepted', 'declined', 'ended'])
          ||
          (resource.data.caller == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['ended', 'cancelled'])
        );
      allow delete: if false;

      match /callerCandidates/{cid} {
        allow read: if signedIn() && (get(/databases/$(database)/documents/calls/$(callId)).data.caller == request.auth.uid
          || get(/databases/$(database)/documents/calls/$(callId)).data.callee == request.auth.uid);
        allow create: if signedIn() && get(/databases/$(database)/documents/calls/$(callId)).data.caller == request.auth.uid
          && request.resource.data.keys().hasOnly(['c']) && request.resource.data.c is string && request.resource.data.c.size() < 3000;
      }
      match /calleeCandidates/{cid} {
        allow read: if signedIn() && (get(/databases/$(database)/documents/calls/$(callId)).data.caller == request.auth.uid
          || get(/databases/$(database)/documents/calls/$(callId)).data.callee == request.auth.uid);
        allow create: if signedIn() && get(/databases/$(database)/documents/calls/$(callId)).data.callee == request.auth.uid
          && request.resource.data.keys().hasOnly(['c']) && request.resource.data.c is string && request.resource.data.c.size() < 3000;
      }
    }

    // Follows: only the follower can read their own list (nobody else sees who you follow).
    match /follows/{id} {
      allow get: if signedIn() && (resource.data.follower == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(resource.data.target)) &&
         get(/databases/$(database)/documents/users/$(resource.data.target)).data.get('isPublic', false) == true));
      allow list: if signedIn() && (resource.data.follower == request.auth.uid ||
        (resource.data.target == request.auth.uid ||
         (exists(/databases/$(database)/documents/users/$(resource.data.target)) &&
          get(/databases/$(database)/documents/users/$(resource.data.target)).data.get('isPublic', false) == true)));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['follower', 'target', 'createdAt'])
        && request.resource.data.follower == request.auth.uid
        && request.resource.data.target is string
        && request.resource.data.target != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.target
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.resource.data.target));
      allow update: if false;
      allow delete: if signedIn() && resource.data.follower == request.auth.uid;
    }

    match /chats/{chatId} {
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      // A chat starts either (a) with the owner of a valid 6-digit code, or
      // (b) when the receiver approves a chat request.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'via', 'createdAt'])
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.createdAt == request.time
        && request.resource.data.via is string
        && (
          (request.resource.data.via != 'request' && request.resource.data.via != 'public'
            && get(/databases/$(database)/documents/connectCodes/$(request.resource.data.via)).data.uid in request.resource.data.members
            && get(/databases/$(database)/documents/connectCodes/$(request.resource.data.via)).data.uid != request.auth.uid
            && get(/databases/$(database)/documents/connectCodes/$(request.resource.data.via)).data.expiresAt > request.time)
          ||
          (request.resource.data.via == 'request'
            && exists(/databases/$(database)/documents/requests/$(chatId))
            && get(/databases/$(database)/documents/requests/$(chatId)).data.to == request.auth.uid
            && get(/databases/$(database)/documents/requests/$(chatId)).data.from in request.resource.data.members)
          ||
          (request.resource.data.via == 'public'
            && get(/databases/$(database)/documents/users/$(request.resource.data.members[0] == request.auth.uid ? request.resource.data.members[1] : request.resource.data.members[0])).data.get('isPublic', false) == true)
        );
      // Group chat: made by its owner, 3-20 members. Group ids never contain "_" (1:1 chat ids do).
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'group', 'name', 'owner', 'via', 'createdAt'])
        && request.resource.data.group == true
        && request.resource.data.via == 'group'
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 3 && request.resource.data.members.size() <= 20
        && request.auth.uid in request.resource.data.members
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && !chatId.matches('.*_.*')
        && request.resource.data.createdAt == request.time;
      // Members may only stamp "last message" info (used for unread dots and notifications).
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && chatNotBlocked(chatId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAt', 'lastBy'])
        && request.resource.data.lastBy == request.auth.uid
        && request.resource.data.lastAt == request.time;
      // Group creator may update only group photo and banner; no member/owner changes.
      allow update: if signedIn() && resource.data.group == true
        && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatar','banner'])
        && (!('avatar' in request.resource.data) || (request.resource.data.avatar is string
          && (request.resource.data.avatar == '' || (request.resource.data.avatar.matches('^data:image/jpeg;base64,.*') && request.resource.data.avatar.size() <= 40000))))
        && (!('banner' in request.resource.data) || (request.resource.data.banner is string
          && (request.resource.data.banner == '' || (request.resource.data.banner.matches('^data:image/jpeg;base64,.*') && request.resource.data.banner.size() <= 90000))));
      allow delete: if false;

      // "typing..." marker: each member writes only their own record.
      match /typing/{typerId} {
        allow read: if signedIn() && request.auth.uid in chatMembers(chatId);
        allow create, update: if signedIn() && typerId == request.auth.uid
          && request.auth.uid in chatMembers(chatId)
          && (chatMembers(chatId).size() != 2 || (!(request.auth.uid in get(/databases/$(database)/documents/users/$(chatMembers(chatId)[0])).data.get('blockedUsers', [])) && !(request.auth.uid in get(/databases/$(database)/documents/users/$(chatMembers(chatId)[1])).data.get('blockedUsers', []))))
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time;
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in chatMembers(chatId);
        allow create: if signedIn()
          && request.auth.uid in chatMembers(chatId)
          && chatNotBlocked(chatId)
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'img', 'aud', 'dur', 'videoPath', 'createdAt', 'replyTo'])
          && request.resource.data.senderId == request.auth.uid
          && (!('replyTo' in request.resource.data) || (request.resource.data.replyTo is string && request.resource.data.replyTo.size() <= 150))
          && request.resource.data.createdAt == request.time
          && (
            ('text' in request.resource.data && !('img' in request.resource.data) && !('aud' in request.resource.data) && !('videoPath' in request.resource.data)
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 8000)
            ||
            ('img' in request.resource.data && !('text' in request.resource.data) && !('aud' in request.resource.data) && !('videoPath' in request.resource.data)
              && request.resource.data.img is string
              && request.resource.data.img.size() > 100
              && request.resource.data.img.size() <= 400000)
            ||
            ('videoPath' in request.resource.data && !('text' in request.resource.data)
              && !('img' in request.resource.data) && !('aud' in request.resource.data)
              && request.resource.data.videoPath is string
              && request.resource.data.videoPath.matches('^chat-video/' + chatId + '/' + request.auth.uid + '/[A-Za-z0-9_-]{1,100}/clip[.](mp4|webm)$'))
            ||
            ('aud' in request.resource.data && !('text' in request.resource.data) && !('img' in request.resource.data) && !('videoPath' in request.resource.data)
              && request.resource.data.aud is string
              && request.resource.data.aud.size() > 100
              && request.resource.data.aud.size() <= 400000
              && request.resource.data.dur is int
              && request.resource.data.dur >= 1 && request.resource.data.dur <= 60)
          );
        // Any chat member may change only their own reaction, never another member's.
        allow update: if signedIn()
          && request.auth.uid in chatMembers(chatId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions is map
          && request.resource.data.reactions.size() <= 50
          && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
          && (! (request.auth.uid in request.resource.data.reactions)
              || request.resource.data.reactions[request.auth.uid] in ['❤️','😂','😮','😢','👍','🔥']);
        // Sender may edit only their own text, with server-verified timestamp.
        allow update: if signedIn()
          && request.auth.uid in chatMembers(chatId)
          && resource.data.senderId == request.auth.uid
          && 'text' in resource.data
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 8000
          && request.resource.data.editedAt == request.time;
        // The receiver (not the sender) may stamp "seen" once.
        allow update: if signedIn()
          && request.auth.uid in chatMembers(chatId)
          && resource.data.senderId != request.auth.uid
          && !('seenAt' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt'])
          && request.resource.data.seenAt == request.time;
        allow delete: if signedIn() && request.auth.uid in chatMembers(chatId)
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
