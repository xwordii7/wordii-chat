rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function chatMembers(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    // Public profile (name, level, equipped items). Only Cloud Functions write.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if false;

      // Private: your own connect code and rate-limit data.
      match /private/{doc} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /usernames/{name}     { allow read, write: if false; }
    match /connectCodes/{code}  { allow read, write: if false; }

    match /referrals/{id} {
      allow read: if signedIn() &&
        (id == request.auth.uid || resource.data.inviterUid == request.auth.uid);
      allow write: if false;
    }

    match /rewards/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /shopItems/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in chatMembers(chatId);
        allow create: if signedIn()
          && request.auth.uid in chatMembers(chatId)
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 8000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
